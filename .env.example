# Local PostgreSQL settings for docker-compose.yml only.
# Change these values for your local environment; do not use them in production.
POSTGRES_DB=devtrack
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Backend connection settings. Keep DB_PASSWORD in sync with POSTGRES_PASSWORD.
DB_URL=jdbc:postgresql://localhost:5432/devtrack
DB_USERNAME=devtrack
DB_PASSWORD=change-me-locally

# Required by the backend. Generate a private Base64 secret with:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Keep the generated value only in your ignored .env or process environment.
JWT_SECRET=
JWT_EXPIRATION=PT1H

# Optional AI suggestions. Configure to enable AI issue generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local container ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
